generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  ENUMS
// ============================================================

enum Rol {
  Administrador
  Propietario
  Cliente
}

enum TipoIdentificacion {
  CC
  CE
  TI
  PA
  NIT
}

enum EstadoParcela {
  disponible
  ocupada
}

// Estado de la cuenta de un propietario registrado desde la landing pública.
// Nace `pendiente` (sin usuario) y pasa a `activo` cuando confirma su correo.
enum EstadoPropietario {
  pendiente
  activo
}

enum EstadoVenta {
  pendiente
  pagado
}

// Estado de una solicitud de registro de caficultor hecha desde la landing.
enum EstadoRegistroCaficultor {
  pendiente
  aprobado
  rechazado
}

// Estado de una solicitud de entrega de café sobre una parcela. Nace
// `pendiente`, pasa a `en_gestion` mientras se atiende y termina en
// `gestionada` (atendida) o `cancelado` (descartada).
enum EstadoSolicitudEntrega {
  pendiente
  en_gestion
  gestionada
  cancelado
}

// ============================================================
//  UBICACIÓN (DIVIPOLA - DANE)
// ============================================================

model Departamento {
  id     Int    @id // Código DANE del departamento (2 dígitos)
  nombre String @db.VarChar(100)

  municipios Municipio[]

  @@map("departamentos")
}

model Municipio {
  id             Int    @id // Código DANE del municipio (5 dígitos)
  nombre         String @db.VarChar(100)
  departamentoId Int    @map("departamento_id")

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Restrict)

  @@index([departamentoId])
  @@map("municipios")
}

// ============================================================
//  AUTENTICACIÓN
// ============================================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  rol       Rol      @default(Cliente)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personas             Persona[]
  cliente              Cliente?
  propietario          Propietario?
  ventasCreadas        Venta[]
  suscripcionesCreadas Suscripcion[]

  tarifasMetrajeCreadas        TarifaMetrajeParcela[]
  tarifasMetrajeVersionCreadas TarifaMetrajeParcelaVersion[]

  @@map("users")
}

// ============================================================
//  PERSONAS Y CLIENTES
// ============================================================

model Persona {
  id                 String              @id @default(uuid())
  usuarioId          String?             @map("usuario_id")
  nombre             String              @db.VarChar(150)
  telefono           String?             @db.VarChar(20)
  direccion          String?             @db.Text
  email              String?             @unique @db.VarChar(100)
  tipoIdentificacion TipoIdentificacion? @map("tipo_identificacion")
  identificacion     String?             @unique @db.VarChar(30)
  createdAt          DateTime            @default(now()) @map("created_at")

  // Relación opcional con el usuario del sistema de auth.
  usuario     User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  propietario Propietario?

  @@index([usuarioId])
  @@map("personas")
}

model Cliente {
  id        String   @id @default(uuid())
  usuarioId String   @unique @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario       User          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ventas        Venta[]
  facturaciones Facturacion[]

  @@map("clientes")
}

model Propietario {
  id              String            @id @default(uuid())
  // Nullable: en el registro público el propietario nace `pendiente` sin
  // usuario; el User (rol Propietario) se crea al activar la cuenta.
  usuarioId       String?           @unique @map("usuario_id")
  personaId       String            @unique @map("persona_id")
  estado          EstadoPropietario @default(pendiente)
  // Token de un solo uso para activar la cuenta desde el enlace del correo.
  tokenActivacion String?           @unique @map("token_activacion")
  activadoAt      DateTime?         @map("activado_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  usuario User?   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)
  fincas  Finca[]

  @@map("propietarios")
}

// ============================================================
//  REGISTRO DE CAFICULTORES (solicitudes desde la landing)
// ============================================================

// Solicitud de registro de un caficultor (dueño de finca) hecha desde la
// landing. Nace en estado `pendiente` con los datos capturados inline. Cuando
// un administrador la aprueba se crean User + Persona + Propietario (la
// contraseña es su número de documento) y la solicitud queda `aprobado`.
model RegistroCaficultor {
  id                 String                   @id @default(uuid())
  nombre             String                   @db.VarChar(150)
  email              String                   @db.VarChar(100)
  telefono           String?                  @db.VarChar(20)
  direccion          String?                  @db.Text
  tipoIdentificacion TipoIdentificacion       @map("tipo_identificacion")
  identificacion     String                   @db.VarChar(30)
  estado             EstadoRegistroCaficultor @default(pendiente)
  motivoRechazo      String?                  @map("motivo_rechazo") @db.Text
  // Propietario creado al aprobar (traza; sin FK para no acoplar la tabla).
  propietarioId      String?                  @map("propietario_id")
  // Usuario administrador que revisó la solicitud.
  revisadoPor        String?                  @map("revisado_por")
  revisadoAt         DateTime?                @map("revisado_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([estado])
  @@index([email])
  @@map("registro_caficultores")
}

// ============================================================
//  FINCAS, ETAPAS Y PARCELAS
// ============================================================

model Finca {
  id            String   @id @default(uuid())
  propietarioId String   @map("propietario_id")
  imagenId      String?  @map("imagen_id")
  imagenLocalId String?  @map("imagen_local_id")
  nombre        String   @db.VarChar(100)
  ubicacion     String   @db.Text
  municipio     String   @db.VarChar(100)
  departamento  String   @db.VarChar(100)
  altitudMetros Int?     @map("altitud_metros")
  latitud       Decimal? @db.Decimal(9, 6)
  longitud      Decimal? @db.Decimal(9, 6)
  descripcion   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  propietario Propietario  @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  imagen      ImagenAws?   @relation(fields: [imagenId], references: [id], onDelete: SetNull)
  imagenLocal ImagenLocal? @relation(fields: [imagenLocalId], references: [id], onDelete: SetNull)
  parcelas    Parcela[]

  @@index([propietarioId])
  @@index([imagenId])
  @@index([imagenLocalId])
  @@map("fincas")
}

model Etapa {
  id              String   @id @default(uuid())
  nombre          String   @db.VarChar(100)
  descripcion     String?  @db.Text
  habilitadaVenta Boolean  @default(false) @map("habilitada_venta")
  orden           Int
  createdAt       DateTime @default(now()) @map("created_at")

  parcelasActuales Parcela[] @relation("EtapaActual")
  reportes         Reporte[]

  @@map("etapas")
}

model Parcela {
  id                  String        @id @default(uuid())
  fincaId             String        @map("finca_id")
  etapaActualId       String?       @map("etapa_actual_id")
  versionActualId     String?       @unique @map("version_actual_id")
  estado              EstadoParcela @default(disponible)
  latitud             Decimal?      @db.Decimal(9, 6)
  longitud            Decimal?      @db.Decimal(9, 6)
  // Cuántas veces al año cosecha la parcela (1 a 12). Debe coincidir con la
  // cantidad de filas en `mesesCosecha`.
  temporalidadCosecha Int?          @map("temporalidad_cosecha")
  createdAt           DateTime      @default(now()) @map("created_at")

  finca         Finca           @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  etapaActual   Etapa?          @relation("EtapaActual", fields: [etapaActualId], references: [id], onDelete: SetNull)
  versionActual VersionParcela? @relation("VersionActual", fields: [versionActualId], references: [id], onDelete: SetNull)

  versiones          VersionParcela[]          @relation("ParcelaVersiones")
  imagenes           ImagenParcela[]
  mesesCosecha       MesCosechaParcela[]
  reportes           Reporte[]
  ventas             Venta[]
  suscripciones      Suscripcion[]
  entregas           EntregaParcela[]
  solicitudesEntrega SolicitudEntregaParcela[]

  @@index([fincaId])
  @@index([estado])
  @@index([etapaActualId])
  @@map("parcelas")
}

// Meses del año (1 = enero … 12 = diciembre) en los que la parcela cosecha sus
// cultivos. La cantidad de filas por parcela debe ser igual a
// `Parcela.temporalidadCosecha`; el par (parcela, mes) es único.
model MesCosechaParcela {
  id        String   @id @default(uuid())
  parcelaId String   @map("parcela_id")
  mes       Int
  createdAt DateTime @default(now()) @map("created_at")

  parcela Parcela @relation(fields: [parcelaId], references: [id], onDelete: Cascade)

  @@unique([parcelaId, mes])
  @@index([parcelaId])
  @@map("meses_cosecha_parcela")
}

// Snapshot inmutable de los datos de una parcela en un momento dado.
// Las suscripciones se atan a una versión para preservar precio y datos.
model VersionParcela {
  id                 String   @id @default(uuid())
  parcelaId          String   @map("parcela_id")
  numeroVersion      Int      @map("numero_version")
  nombre             String   @db.VarChar(100)
  descripcion        String?  @db.Text
  tarifaMetrajeId    String?  @map("tarifa_metraje_id")
  precioVentaPublico Decimal  @map("precio_venta_publico") @db.Decimal(10, 2)
  precioCafetero     Decimal  @map("precio_cafetero") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  parcela         Parcela               @relation("ParcelaVersiones", fields: [parcelaId], references: [id], onDelete: Cascade)
  // Back-relation del puntero Parcela.versionActual.
  parcelaActualDe Parcela?              @relation("VersionActual")
  tarifaMetraje   TarifaMetrajeParcela? @relation(fields: [tarifaMetrajeId], references: [id], onDelete: SetNull)
  ventas          Venta[]

  @@unique([parcelaId, numeroVersion])
  @@index([parcelaId])
  @@index([tarifaMetrajeId])
  @@map("version_parcelas")
}

// Imágenes fijas de la parcela (portada/galería). Son independientes de los
// reportes de avance: cada fila relaciona la parcela con una ImagenLocal.
model ImagenParcela {
  id            String   @id @default(uuid())
  parcelaId     String   @map("parcela_id")
  imagenLocalId String   @map("imagen_local_id")
  orden         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  parcela     Parcela     @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  imagenLocal ImagenLocal @relation(fields: [imagenLocalId], references: [id], onDelete: Cascade)

  @@index([parcelaId, orden])
  @@index([imagenLocalId])
  @@map("imagenes_parcela")
}

// ============================================================
//  TARIFAS DE METRAJE DE PARCELAS
// ============================================================

// Catálogo de tarifas por metraje. Cada tarifa apunta a su versión actual
// (versionId) y conserva el historial completo en `versiones`. No se actualiza
// el valor: se crean versiones nuevas y se reasigna el puntero a la actual.
model TarifaMetrajeParcela {
  id                    String   @id @default(uuid())
  medidaMetrosCuadrados Decimal  @map("medida_metros_cuadrados") @db.Decimal(12, 2)
  versionId             String?  @unique @map("version_id")
  createdAt             DateTime @default(now()) @map("created_at")
  createdBy             String?  @map("created_by")

  versionActual    TarifaMetrajeParcelaVersion?  @relation("TarifaMetrajeVersionActual", fields: [versionId], references: [id], onDelete: SetNull)
  creadoPor        User?                         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  versiones        TarifaMetrajeParcelaVersion[] @relation("TarifaMetrajeVersiones")
  versionesParcela VersionParcela[]
  ventas           Venta[]

  @@map("tarifas_metraje_parcelas")
}

// Snapshot inmutable del valor de una tarifa de metraje en un momento dado.
model TarifaMetrajeParcelaVersion {
  id                              String   @id @default(uuid())
  tarifaMedidaId                  String   @map("tarifa_medida_id")
  valorVenta                      Decimal  @map("valor_venta") @db.Decimal(10, 2)
  // Valor que se le paga al propietario por cada kg entregado. El front lo
  // multiplica por los kg que el propietario va a entregar.
  valorProduccionPropietarioPorKg Decimal  @default(0) @map("valor_produccion_propietario_por_kg") @db.Decimal(10, 2)
  produccionKg                    Decimal  @map("produccion_kg") @db.Decimal(12, 2)
  cantidadMinimaEntrega           Decimal  @map("cantidad_minima_entrega") @db.Decimal(12, 2)
  createdAt                       DateTime @default(now()) @map("created_at")
  createdBy                       String?  @map("created_by")

  tarifa             TarifaMetrajeParcela      @relation("TarifaMetrajeVersiones", fields: [tarifaMedidaId], references: [id], onDelete: Cascade)
  // Back-relation del puntero TarifaMetrajeParcela.versionActual.
  tarifaActualDe     TarifaMetrajeParcela?     @relation("TarifaMetrajeVersionActual")
  creadoPor          User?                     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  // Solicitudes de entrega que congelaron esta versión como base de pago.
  solicitudesEntrega SolicitudEntregaParcela[]

  @@index([tarifaMedidaId])
  @@map("tarifas_metraje_parcelas_version")
}

// ============================================================
//  VENTAS, SUSCRIPCIONES Y FACTURACIÓN
// ============================================================

// Venta de una parcela. Nace en estado `pendiente` con los datos del comprador
// guardados inline (el Cliente/User/Persona reales se crean al completar). Al
// confirmarse el pago en Stripe pasa a `pagado`: se crea el cliente, la
// suscripción, la facturación y la transacción, y la parcela queda ocupada.
model Venta {
  id               String      @id @default(uuid())
  versionParcelaId String      @map("version_parcela_id")
  parcelaId        String      @map("parcela_id")
  clienteId        String?     @map("cliente_id") // se llena al completar el pago
  tarifaMetrajeId  String?     @map("tarifa_metraje_id")
  valor            Decimal     @db.Decimal(10, 2)
  estado           EstadoVenta @default(pendiente)
  suscripcionId    String?     @unique @map("suscripcion_id")

  // Datos del comprador capturados al crear la venta.
  clienteNombre         String  @map("cliente_nombre") @db.VarChar(150)
  clienteEmail          String  @map("cliente_email") @db.VarChar(100)
  clienteTelefono       String? @map("cliente_telefono") @db.VarChar(20)
  clienteDireccion      String? @map("cliente_direccion") @db.Text
  clienteIdentificacion String? @map("cliente_identificacion") @db.VarChar(30)

  // Stripe: id de la sesión de Checkout para correlacionar el webhook.
  stripeSessionId String? @unique @map("stripe_session_id")

  createdAt DateTime @default(now()) @map("created_at")
  // Usuario que registró la venta; null cuando la inicia un cliente anónimo.
  createdBy String?  @map("created_by")

  versionParcela      VersionParcela        @relation(fields: [versionParcelaId], references: [id], onDelete: Restrict)
  parcela             Parcela               @relation(fields: [parcelaId], references: [id], onDelete: Restrict)
  cliente             Cliente?              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tarifaMetraje       TarifaMetrajeParcela? @relation(fields: [tarifaMetrajeId], references: [id], onDelete: SetNull)
  suscripcion         Suscripcion?          @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)
  creadoPor           User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  facturaciones       Facturacion[]
  transaccionesStripe TransaccionStripe[]

  @@index([parcelaId])
  @@index([clienteId])
  @@index([versionParcelaId])
  @@index([tarifaMetrajeId])
  @@map("ventas")
}

// Registro de cada evento de pago de Stripe asociado a una venta. `eventId`
// (id del evento de Stripe) es único para garantizar idempotencia del webhook.
model TransaccionStripe {
  id              String   @id @default(uuid())
  ventaId         String   @map("venta_id")
  eventId         String?  @unique @map("event_id")
  sessionId       String?  @map("session_id")
  paymentIntentId String?  @map("payment_intent_id")
  monto           Decimal  @db.Decimal(10, 2)
  moneda          String   @db.VarChar(10)
  estado          String   @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([ventaId])
  @@map("transacciones_stripe")
}

// Contrato de arriendo. Solo se crea cuando una venta pasa a `pagado`.
model Suscripcion {
  id          String   @id @default(uuid())
  parcelaId   String   @map("parcela_id")
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  fechaFin    DateTime @map("fecha_fin") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  // Hereda el createdBy de la venta; null cuando la inició un cliente anónimo.
  createdBy   String?  @map("created_by")

  parcela   Parcela          @relation(fields: [parcelaId], references: [id], onDelete: Restrict)
  creadoPor User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  // Back-relation del puntero Venta.suscripcion (1:1).
  venta     Venta?
  entregas  EntregaParcela[]

  @@index([parcelaId])
  @@map("suscripciones")
}

// Registro de cada entrega de café hecha sobre una parcela. La parcela produce
// y entrega esté alquilada o no, por eso el dueño de la entrega es la parcela:
// `suscripcionId` solo anota a qué contrato se imputó (null si no había ninguno)
// y `solicitudId` a qué solicitud responde. Guarda cuánto se entregó, cuánto se
// pagó y el comprobante (imagen opcional en el servicio local de imágenes).
model EntregaParcela {
  id                      String   @id @default(uuid())
  parcelaId               String   @map("parcela_id")
  cantidadEntregada       Decimal  @map("cantidad_entregada") @db.Decimal(12, 2)
  valorPagado             Decimal  @map("valor_pagado") @db.Decimal(10, 2)
  imagenComprobantePagoId String?  @map("imagen_id_comprobante_pago")
  suscripcionId           String?  @map("suscripcion_id")
  solicitudId             String?  @map("solicitud_id")
  createdAt               DateTime @default(now()) @map("created_at")

  parcela           Parcela                  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  // SetNull en ambos: cerrar un contrato o borrar una solicitud no puede borrar
  // el histórico de producción de la parcela.
  suscripcion       Suscripcion?             @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)
  solicitud         SolicitudEntregaParcela? @relation(fields: [solicitudId], references: [id], onDelete: SetNull)
  imagenComprobante ImagenLocal?             @relation(fields: [imagenComprobantePagoId], references: [id], onDelete: SetNull)

  @@index([parcelaId, createdAt])
  @@index([suscripcionId])
  @@index([solicitudId])
  @@index([imagenComprobantePagoId])
  @@map("entregas_parcela")
}

// Solicitud de entrega de café sobre una parcela: cuántos kilos se piden y en
// qué estado va la gestión. Las entregas que la atienden la referencian desde
// `EntregaParcela.solicitudId`.
model SolicitudEntregaParcela {
  id              String   @id @default(uuid())
  parcelaId       String   @map("parcela_id")
  cantidadKg      Decimal  @map("cantidad_kg") @db.Decimal(12, 2)
  // Versión de tarifa vigente al momento de solicitar: deja constancia de con
  // qué valor por kg se le va a pagar al propietario. Nullable porque la
  // parcela puede no tener tarifa asignada todavía.
  tarifaVersionId String?  @map("tarifa_version_id")
  // Estimado de pago congelado al crear: cantidadKg × valor por kg de esa
  // versión de tarifa.
  valor           Decimal? @db.Decimal(12, 2)

  estado    EstadoSolicitudEntrega @default(pendiente)
  createdAt DateTime               @default(now()) @map("created_at")

  parcela       Parcela                      @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  tarifaVersion TarifaMetrajeParcelaVersion? @relation(fields: [tarifaVersionId], references: [id], onDelete: SetNull)
  entregas      EntregaParcela[]

  @@index([parcelaId, createdAt])
  @@index([estado])
  @@index([tarifaVersionId])
  @@map("solicitudes_entregas_parcelas")
}

// Registro del pago de una venta. Solo se crea cuando la venta pasa a `pagado`.
model Facturacion {
  id        String   @id @default(uuid())
  ventaId   String   @map("venta_id")
  clienteId String   @map("cliente_id")
  valor     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  venta   Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@index([clienteId])
  @@map("facturacion")
}

// ============================================================
//  IMÁGENES (S3)
// ============================================================

// Tabla genérica: sin FK al negocio. El contexto lo dan tablas
// como NovedadDetalle u otras que la referencien a futuro.
model ImagenAws {
  id        String   @id @default(uuid())
  urlS3     String   @map("url_s3") @db.Text
  bucket    String   @db.VarChar(100)
  keyS3     String   @map("key_s3") @db.Text
  tipo      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  fincas Finca[]

  @@map("imagenes_aws")
}

// Imágenes almacenadas en el servicio propio (https://mycoffeefarm.com/api-imagenes).
// El `id` lo genera el servicio remoto al subir; `url` es la ruta relativa que
// devuelve. El servicio no guarda metadatos: esta tabla es la única referencia.
model ImagenLocal {
  id        String   @id
  project   String   @db.VarChar(100)
  url       String   @db.Text
  tipo      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  reportesImagenes    ReporteImagen[]
  imagenesParcela     ImagenParcela[]
  fincas              Finca[]
  entregasComprobante EntregaParcela[]

  @@map("imagenes_locales")
}

// ============================================================
//  REPORTES DE PARCELA (reportes de avance)
// ============================================================

// Cabecera de un reporte de avance de una parcela. Tanto la etapa como
// la descripción son opcionales; las imágenes viven en ReporteImagen.
// El registro más reciente (createdAt) representa el estado actual.
model Reporte {
  id          String   @id @default(uuid())
  parcelaId   String   @map("parcela_id")
  etapaId     String?  @map("etapa_id")
  descripcion String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  parcela  Parcela         @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  etapa    Etapa?          @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  imagenes ReporteImagen[]

  @@index([parcelaId, createdAt])
  @@map("reportes")
}

// Imagen de un reporte: cada fila relaciona el reporte con una ImagenLocal.
model ReporteImagen {
  id            String   @id @default(uuid())
  reporteId     String   @map("reporte_id")
  imagenLocalId String   @map("imagen_local_id")
  createdAt     DateTime @default(now()) @map("created_at")

  reporte     Reporte     @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  imagenLocal ImagenLocal @relation(fields: [imagenLocalId], references: [id], onDelete: Cascade)

  @@index([reporteId])
  @@index([imagenLocalId])
  @@map("reportes_imagenes")
}

// ============================================================
//  CORREOS ADMINISTRATIVOS DE NOTIFICACIONES
// ============================================================

// Correos internos que reciben avisos del sistema. Cada bandera indica a qué
// tipo de notificación está suscrito el correo. `estado` habilita/deshabilita
// el envío sin borrar el registro y `deletedAt` marca el borrado lógico.
model CorreoAdministrativoNotificacion {
  id                                      String    @id @default(uuid())
  correo                                  String    @db.VarChar(255)
  estado                                  Boolean   @default(true)
  notificarVentasParcelas                 Boolean   @default(false) @map("notificar_ventas_parcelas")
  notificarSolicitudesEntregaPropietarios Boolean   @default(false) @map("notificar_solicitudes_entrega_propietarios")
  createdAt                               DateTime  @default(now()) @map("created_at")
  deletedAt                               DateTime? @map("deleted_at")

  @@index([correo])
  @@index([estado, deletedAt])
  @@map("correos_administrativos_notificaciones")
}
