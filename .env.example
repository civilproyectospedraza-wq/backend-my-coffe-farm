# Servidor
PORT=8091

# Base de datos (la conexión la pegas aquí cuando la tengas)
DATABASE_URL="postgresql://usuario:password@localhost:5432/back_coffe?schema=public"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES_IN="1d"

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME=""

# URLs del front (usadas en los correos)
APP_LOGIN_URL="https://mycoffeefarm.com/login"
APP_ACTIVACION_URL="https://mycoffeefarm.com/activar-cuenta"

# Correo (Mailgun, API HTTP). MAILGUN_API_BASE: US https://api.mailgun.net
# (por defecto) | EU https://api.eu.mailgun.net (según la región de tu cuenta).
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_API_BASE="https://api.mailgun.net"
MAIL_FROM="My Coffee Farm <postmaster@tu-dominio-mailgun>"
